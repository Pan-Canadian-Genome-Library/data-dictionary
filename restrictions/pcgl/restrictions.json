{
    "name": "default_pcgl_schema",
    "description": "...",
    "schemas": [
        {
            "name": "participant",
            "fields":[
                {
                    "name":"sex_another_category",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["sex_at_birth"],
                                    "match":{"value":"Another Sex"},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                }
            ]
        },
        {
            "name": "treatment",
            "fields":[
                {
                    "name":"submitter_diagnosis_id",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["submitter_treatment_id"],
                                    "match":{"exists": false},
                                    "case" : "all"
                                }
                            ]

                        },
                        "then":{"required": false, "regex": "^[A-Za-z0-9\\-\\._]{1,64}$"}
                    }
                },
                {
                    "name":"treatment_type_other",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["treatment_type"],
                                    "match":{"value": "Other"},
                                    "case" : "all"
                                }
                            ]

                        },
                        "then":{"required": false},
                        "else":{
                            "required": false,
                            "empty": true
                        }
                    }
                }
            ]
        },
        {
            "name": "sociodemographic",
            "fields" : [
                {
                    "name":"age_at_sociodem_collection",
                    "valueType": "integer",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["age_at_sociodem_collection_missing_reason"],
                                    "match":{"exists":true},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                },
                {
                    "name":"age_at_sociodem_collection_missing_reason",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["age_at_sociodem_collection"],
                                    "match":{"exists":true},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                },
                {
                    "name":"race_another_racial_category",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["race"],
                                    "match":{"codeList": ["Another Racial Category"]},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"gender_another_gender",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["gender"],
                                    "match":{"value":"Another Gender"},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"ethnicity_another_category",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["ethnicity"],
                                    "match":{"codeList": ["Another Ethnic or Cultural Origin"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"sex_another_category",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["sex_at_birth"],
                                    "match":{"value":"Another Sex"},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"sociodem_question_detail",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["sociodem_question"],
                                    "match":{"codeList":["PCGL reference question","Another question"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"another_employment_status",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["employment_status"],
                                    "match":{"codeList":["Another status of employment"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"another_household_tenure",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["household_tenure"],
                                    "match":{"codeList":["Another status of tenure"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"another_accommodation_type",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["accommodation_type"],
                                    "match":{"codeList":["Another accommodation type"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"pob_outside_canada",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["place_of_birth"],
                                    "match":{"codeList":["Outside of Canada"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"arrival_in_canada",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["place_of_birth"],
                                    "match":{"codeList":["Outside of Canada"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{
                            "required":true,
                            "codeList": [
                                "Less than 5 years",
                                "5-9 years",
                                "10 or more years",
                                "Do not know",
                                "Prefer not to answer",
                                "Missing - Unknown",
                                "Missing - Not collected",
                                "Missing - Not provided",
                                "Missing - Restricted access"
                            ]
                        },
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"parent1_another_pob",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["parent1_place_of_birth"],
                                    "match":{"codeList":["Outside of Canada"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"parent2_another_pob",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["parent2_place_of_birth"],
                                    "match":{"codeList":["Outside of Canada"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"first_language_another_language",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["first_language"],
                                    "match":{"codeList":["Another Language"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"knowledge_non_official_language",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["knowledge_official_languages"],
                                    "match":{"codeList":["Non-official language"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"knowledge_official_language_preference",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["knowledge_official_languages"],
                                    "match":{"codeList":["Non-official language"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{
                            "required":true,
                            "codeList":[
                                "English",
                                "French",
                                "Missing - Unknown",
                                "Missing - Not collected",
                                "Missing - Not provided",
                                "Missing - Restricted access"
                            ]
                        },
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"geographic_location_additional",
                    "valueType": "string",
                    "restrictions" : {
                        "required": false
                    }
                },
                {
                    "name":"religion_free_text_input",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["religion"],
                                    "match":{"codeList":["Religious"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"total_income_support",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["total_income_collect_method"],
                                    "match":{"codeList":["Missing - Unknown","Missing - Not collected","Missing - Not provided","Missing - Restricted access"]},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                }
            ]
        },
        {
            "name": "read_group",
            "fields" : [
                {
                    "name":"file_r2",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["library_layout"],
                                    "match":{"value":"OBI:0000722 (paired-end library)"},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                }
            ]
        },
        {
            "name": "analysis",
            "fields" : [
                {
                    "name":"submitter_experiment_ids",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields": ["analysisType"],
                                    "match":{
                                        "codeList":[
                                            "sequenceExperiment",
                                            "sequenceAlignment",
                                            "variantCall"
                                            ]
                                        },
                                    "case": "any"
                                }
                            ]
                        },
                        "then":{"required":true},
                        "else":{"required":false,"empty":true}
                    }
                },
                {
                    "name":"submitter_participant_ids",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["submitter_experiment_ids","submitter_sample_ids","submitter_specimen_ids"],
                                    "match":{"exists": true},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                },
                {
                    "name":"submitter_sample_ids",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["submitter_participant_ids","submitter_experiment_ids","submitter_specimen_ids"],
                                    "match":{"exists": true},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                },
                {
                    "name":"submitter_specimen_ids",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["submitter_participant_ids","submitter_experiment_ids","submitter_sample_ids"],
                                    "match":{"exists": true},
                                    "case": "any"
                                }
                            ]

                        },
                        "then":{"required":false,"empty":true},
                        "else":{"required":true}
                    }
                }
            ]
        },
        {
            "name": "study",
            "fields":[
                {
                    "name":"disease_specific_modifier",
                    "valueType": "string",
                    "restrictions" : {
                        "if":{
                            "conditions": [
                                {
                                    "fields":["duo_permission"],
                                    "match":{"value": "DUO:0000007 (disease specific research)"},
                                    "case": "all"
                                }
                            ]

                        },
                        "then":{"required": true, "regex": "^MONDO:\\d{7}$"},
                        "else":{"required": false, "empty": true}
                    }
                }
            ]
        }
    ]
}
