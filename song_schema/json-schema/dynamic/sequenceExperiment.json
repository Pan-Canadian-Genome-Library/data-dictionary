{
  "name": "sequenceExperiment",
  "options": {
    "fileTypes": [
      "BAM",
      "FASTQ"
    ],
    "externalValidations": [
      {
        "url": "http://submission.submission.svc.cluster.local/validator/entity/experiment/field/submitter_experiment_id/exists?study={study}&value={value}",
        "jsonPath": "submitter_experiment_ids"
      }
    ]
  },
  "schema": {
    "properties": {
      "data_category": {
        "description": "",
        "enum": [
          "Genomics",
          "Transcriptomics",
          "Proteomics",
          "Epigenomics",
          "Imaging",
          "Reference"
        ],
        "type": "string"
      },
      "submitter_analysis_id": {
        "description": "Unique identifier of the analysis within the study, assigned by the data provider.",
        "pattern": "^[A-Za-z0-9\\-\\._]{1,64}$",
        "type": "string"
      },
      "submitter_experiment_ids": {
        "description": "List of Unique identifier for experiments within the study, assigned by the data provider.",
        "items": {
          "pattern": "^[A-Za-z0-9\\-\\._]{1,64}$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    },
    "required": [
      "submitter_experiment_ids",
      "submitter_analysis_id",
      "data_category"
    ],
    "type": "object"
  }
}